# =============================================================================
# FAISI AI — Server Environment Configuration Template
# Copy this file to .env and configure for your target environment.
# NEVER commit real production secrets or .env files to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Server Configuration
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
LOG_LEVEL=INFO
CLIENT_URL=http://localhost:3000
TRUST_PROXY=1
SHUTDOWN_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# 2. Authentication & Session Security
# -----------------------------------------------------------------------------
# In production, AUTH_SECRET MUST be a cryptographically secure random string (>=32 chars).
# Example to generate: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here_min_32_characters_random
AUTH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# 3. Database (MongoDB)
# -----------------------------------------------------------------------------
# Production MongoDB Atlas URI or local MongoDB daemon
MONGODB_URI=mongodb://localhost:27017/nova_ai
MONGODB_DB_NAME=nova_ai

# -----------------------------------------------------------------------------
# 4. Google Gemini AI & Model Intelligence
# -----------------------------------------------------------------------------
# Obtain API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
REQUEST_TIMEOUT_MS=30000
AI_STREAM_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# 5. Document Processing & Quotas (Phase 6)
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=10
MAX_USER_STORAGE_MB=100
MAX_DOCUMENTS_PER_USER=50
MAX_EXTRACTED_TEXT_CHARS=100000
MAX_ANALYSIS_CONTEXT_CHARS=50000
MAX_INSTRUCTION_CHARS=1000
MAX_CSV_ROWS=10000
MAX_CSV_COLUMNS=100
MAX_CSV_FIELD_LENGTH=1000
MAX_CSV_TOTAL_CELLS=50000
DOCUMENT_EXTRACTION_TIMEOUT_MS=30000
DOCUMENT_ANALYSIS_TIMEOUT_MS=30000
MAX_CONCURRENT_DOCUMENT_PROCESSING=2
STORAGE_DIR=storage/documents

# -----------------------------------------------------------------------------
# 6. RAG & Knowledge Base Vector Store (Phase 7)
# -----------------------------------------------------------------------------
# Vector store provider: 'mongodb_atlas' for production or 'local_memory' for development/testing
VECTOR_STORE_TYPE=mongodb_atlas
ALLOW_IN_MEMORY_VECTOR_STORE_IN_PROD=false
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=20
RAG_TOP_K=5
RAG_NUM_CANDIDATES=50
RAG_SIMILARITY_THRESHOLD=0.65
MAX_CHUNKS_PER_DOCUMENT=250
MAX_TOTAL_CHUNKS_PER_USER=2500
MAX_CONCURRENT_INDEXING_JOBS=1
MAX_RAG_CONTEXT_CHARS=12000
MAX_RAG_QUERY_CHARS=500
EMBEDDING_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# 7. Voice & Multimodal Intelligence (Phase 8 & 9.3-A)
# -----------------------------------------------------------------------------
MULTIMODAL_ENABLED=true
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_MESSAGE=3
MAX_IMAGE_DIMENSION=4096
VOICE_INPUT_ENABLED=true
MAX_AUDIO_SIZE_MB=10
MAX_AUDIO_DURATION_SECONDS=60
TRANSCRIPTION_MODEL=gemini-3.5-transcribe
TTS_ENABLED=true
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_DEFAULT_VOICE=Aoede
MAX_TTS_CHARS=2000
TTS_CACHE_MAX_MB=50
TTS_CACHE_TTL_SECONDS=1800
LIVE_VOICE_ENABLED=false
LIVE_VOICE_MODEL=gemini-3.1-flash-live-preview
MAX_LIVE_SESSIONS_PER_USER=1
MEDIA_STORAGE_DIR=storage/media

# -----------------------------------------------------------------------------
# 8. Global Upload & RAM Concurrency Protection (Phase 9.3-D)
# -----------------------------------------------------------------------------
MAX_CONCURRENT_UPLOADS=10
MAX_CONCURRENT_UPLOADS_PER_USER=2
